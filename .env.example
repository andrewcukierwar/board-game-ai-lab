# Backend only. Copy to ignored root .env for local Python/Gunicorn development.
# Existing exported variables take precedence. Never use a VITE_ prefix for secrets.
EXPLANATIONS_ENABLED=false
OPENAI_API_KEY=
OPENAI_EXPLANATION_MODEL=gpt-6-luna
OPENAI_EXPLANATION_REASONING_EFFORT=none
EXPLANATION_MAX_OUTPUT_TOKENS=400
EXPLANATION_TIMEOUT_SECONDS=20
EXPLANATION_MAX_QUESTION_LENGTH=500
EXPLANATION_GAME_LIMIT=8
EXPLANATION_CLIENT_LIMIT=20
EXPLANATION_GLOBAL_LIMIT=100
EXPLANATION_WINDOW_SECONDS=3600
EXPLANATION_MAX_CONCURRENT=2
EXPLANATION_CACHE_SIZE=256
EXPLANATION_CACHE_TTL_SECONDS=1800
EXPLANATION_CLIENT_CAPACITY=1024
# Exact allowed frontend origins, comma separated. Empty uses same-origin only.
CORS_ALLOWED_ORIGINS=

# Public Funnel API hardening (global per-process budgets; no proxy-IP trust).
# Tune against observed Season/Tournament traffic after deployment.
PUBLIC_RATE_LIMIT_ENABLED=true
PUBLIC_REQUEST_RATE_PER_SECOND=60
PUBLIC_REQUEST_BURST=160
PUBLIC_START_RATE_PER_SECOND=8
PUBLIC_START_BURST=40
PUBLIC_SEARCH_CONCURRENCY=2
